{
  "name": "bladetide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @bladetide/api run dev",
    "api:dev": "npm --workspace @bladetide/api run dev",
    "api:start": "npm --workspace @bladetide/api run start",
    "room:dev": "npm --workspace @bladetide/room-server run dev",
    "room:start": "npm --workspace @bladetide/room-server run start",
    "room:test": "npm --workspace @bladetide/room-server run test",
    "room:typecheck": "npm --workspace @bladetide/room-server run typecheck",
    "web:serve": "node scripts/serve-web.mjs apps/web 8137",
    "game-core:test": "node --test packages/game-core/test/sim.test.js",
    "game-core:sim": "node packages/game-core/bin/sim.js",
    "api:test": "npm --workspace @bladetide/api run test",
    "api:typecheck": "tsc --noEmit -p apps/api",
    "hedera:setup": "npm --workspace @bladetide/api run hedera:setup --",
    "hedera:wallet": "npm --workspace @bladetide/api run hedera:wallet --",
    "hedera:claim": "npm --workspace @bladetide/api run hedera:claim --",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/room-server"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
